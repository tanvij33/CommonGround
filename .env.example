# ==============================================================================
# COMMON GROUND — ENVIRONMENT CONFIGURATION (TEMPLATE)
# Qloo Hackathon Docs: https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide
# Server Base URL:     https://hackathon.api.qloo.com
# ==============================================================================

# INSERT YOUR QLOO API KEY HERE:
QLOO_API_KEY=your_qloo_api_key_here

# Qloo Hackathon API Base URL
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Mode switch:
# Set QLOO_MOCK=false to connect to the live Qloo Hackathon API (default)
# Set QLOO_MOCK=true for offline development
QLOO_MOCK=false

# LLM Configuration (supports 'mock', 'openai', 'gemini')
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o

# SQLite database path for persistent storage & response caching
DATABASE_URL=sqlite:///./data/common_ground.db
